{
  "expo": {
    "name": "KrisiMarg Field Officer",
    "slug": "krisimarg-field-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#198754",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KrisiMarg needs your GPS location to record field check-in and visit coordinates."
      }
    },
    "android": {
      "package": "com.krisimarg.fieldofficer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#198754"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow KrisiMarg to access your location for field attendance and location-tagged reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KrisiMarg to access photos to upload expense receipts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "36c6434e-5856-48f5-81a9-eb466b87d025"
      }
    }
  }
}
